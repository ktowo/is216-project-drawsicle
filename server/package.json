{
  "name": "drawsicle-server",
  "version": "1.0.0",
  "description": "Backend server for Drawsicle.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "run": "node server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "supabase:sql": "node scripts/supabase-sync.js --sql",
    "supabase:tables": "node scripts/supabase-sync.js --apply-schema",
    "supabase:sync": "node scripts/supabase-sync.js",
    "supabase:import-users": "node scripts/supabase-import-users.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
