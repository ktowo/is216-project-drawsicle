# Copy to server/.env (Start-all does this for you and fills in the secrets).
# On Vercel, set these in the project's Environment Variables instead (see "Deploying to Vercel" in the README).

# MongoDB connection string, e.g. from MongoDB Atlas. Vercel's MongoDB Atlas integration sets this one.
# MONGODB_URI or DB work too. Leave it as the placeholder (or empty) to use the built-in local database in server/.data
DB_MONGODB_URI=[MongoDB Connection String]?retryWrites=true&w=majority
SECRET=[Long randomly-generated string]
JWT_SECRET=[Long randomly-generated string]
HOST=localhost
PORT=8000
CLIENT_URL=http://localhost:5173
ADMIN_EMAILS=[Comma-separated admin emails]

# Local database (only used when no connection string is set)
LOCAL_DB_PORT=27018
# Load the demo accounts/events into an empty local database
SEED_DEMO=true

# How often deadline reminders run, in minutes
REMINDER_INTERVAL_MINUTES=60
# Vercel Cron: set a long random string and Vercel signs its daily /api/cron/reminders call with it
CRON_SECRET=

# Which sign-in to use: local (the app's own: email + password, Google, Discord) or supabase
# (Supabase Auth, docs/specs/supabase-auth-email.md). supabase also needs SUPABASE_URL below.
AUTH_PROVIDER=local

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: Discord sign-in
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Optional: real emails (otherwise they're printed in the server log). Resend: docs/EMAIL.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Drawsicle <no-reply@drawsicle.app>
# Resend is the easiest option for Vercel. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM=Drawsicle <no-reply@your-domain.example>

# Where uploaded images go. Picked for you: Supabase or Azure when set up below, the database
# (GridFS) when using a connection string above, otherwise server/uploads.
# Set supabase, azure, mongodb or local to choose.
UPLOAD_STORAGE=
# Optional: Supabase Storage for uploads (a public bucket, made on first upload if missing).
# The service role key is a secret: keep it here and in Vercel's environment, never in the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The project's public (anon / publishable) key: Supabase sign-in checks tokens with it
SUPABASE_ANON_KEY=
# Which sign-in buttons to show with AUTH_PROVIDER=supabase (switched on in Supabase too)
SUPABASE_OAUTH_PROVIDERS=google,discord
SUPABASE_STORAGE_BUCKET=drawsicle
# Optional: Azure Blob Storage for uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=drawsicle

# Optional: art style matching with a vision model on Ollama (docs/VISION.md). Without it, styles
# are compared by colour and texture only. Local: http://127.0.0.1:11434 (run-ollama.sh starts it).
# Deployed: the Cloudflare Tunnel's hostname, plus a Cloudflare Access service token.
OLLAMA_URL=
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
