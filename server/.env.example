# Copy to server/.env (Start-all does this for you and fills in the secrets).
# On Vercel, set these in the project's Environment Variables instead (see "Deploying to Vercel" in the README).

# MongoDB connection string, e.g. from MongoDB Atlas. Vercel's MongoDB Atlas integration sets this one.
# MONGODB_URI or DB work too. Leave it as the placeholder (or empty) to use the built-in local database in server/.data
DB_MONGODB_URI=[MongoDB Connection String]?retryWrites=true&w=majority
SECRET=[Long randomly-generated string]
JWT_SECRET=[Long randomly-generated string]
HOST=localhost
PORT=8000
CLIENT_URL=http://localhost:5173
ADMIN_EMAILS=[Comma-separated admin emails]

# Local database (only used when no connection string is set)
LOCAL_DB_PORT=27018
# Load the demo accounts/events into an empty local database
SEED_DEMO=true

# How often deadline reminders run, in minutes
REMINDER_INTERVAL_MINUTES=60
# Vercel Cron: set a long random string and Vercel signs its daily /api/cron/reminders call with it
CRON_SECRET=

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: Discord sign-in
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Optional: real emails (otherwise they're printed in the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Drawsicle <no-reply@drawsicle.app>

# Where uploaded images go. Picked for you: Azure when it's set up below, the database (GridFS)
# when using a connection string above, otherwise server/uploads. Set azure, mongodb or local to choose.
UPLOAD_STORAGE=
# Optional: Azure Blob Storage for uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=drawsicle
