# Settings for run-ollama.sh / run-ollama.bat. Copy this file to ollama.env (which git ignores).
# See docs/VISION.md for the whole set-up.

# The vision model that describes each artwork's style, and the text embedding model
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama only listens on this computer; the tunnel is the way in from outside
OLLAMA_PORT=11434

# Token of your Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > the install
# command contains it). Leave empty to keep Ollama on this computer only.
CLOUDFLARE_TUNNEL_TOKEN=
