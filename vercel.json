{
  "services": {
    "frontend": {
      "root": "client/",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "server/",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
